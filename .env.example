# Copy this file to `.env` and fill in the values (see README.md → Setup).

# --- Firebase (Project settings → Your apps → Web app config) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=

# Where the WhatsApp invite links point (your Firebase Hosting site, no trailing slash)
EXPO_PUBLIC_INVITE_BASE_URL=https://your-project.web.app

# --- Google Maps SDK keys (Google Cloud Console → APIs & Services → Credentials) ---
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Android package / iOS bundle id (must be unique on the stores)
APP_BUNDLE_ID=com.ridetogether.app
