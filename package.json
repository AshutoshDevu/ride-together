    "expo-battery": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.26",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "firebase": "^13.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "firebase-tools": "^15.34.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "deploy:firebase": "npm run build:web && firebase deploy --only hosting,database",
    "web": "expo start --web",
    "emulators": "firebase emulators:start --only auth,database,firestore,hosting --project demo-ridetogether",
    "simulate": "node scripts/simulate-ride.mjs",
    "build:web": "EXPO_WEB_BASE_URL=/app expo export --platform web --output-dir hosting/public/app --clear",
    "deploy:web": "npm run build:web && firebase deploy --only hosting",
    "test:rules": "node --test tests/*.test.mjs"
  },
  "private": true
