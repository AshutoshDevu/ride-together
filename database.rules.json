{
  "rules": {
    ".read": false,
    ".write": false,
    "groups": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)",
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid",
          ".validate": "newData.hasChildren(['name', 'createdBy', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length <= 60",
          "endedAt": {
            ".write": "auth != null && root.child('groups').child($code).child('meta').child('createdBy').val() === auth.uid && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          }
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || !root.child('groups').child($code).child('meta').child('endedAt').exists()) && (root.child('groups').child($code).child('meta').exists() || newData.parent().parent().child('meta').exists())",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'color', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 40)",
            "colorIdx": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15"
            }
          }
        },
        "locations": {
          ".write": "auth != null && root.child('groups').child($code).child('meta').child('createdBy').val() === auth.uid && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ((root.child('groups').child($code).child('members').child(auth.uid).exists() && !root.child('groups').child($code).child('meta').child('endedAt').exists()) || !newData.exists())",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "status": {
              ".validate": "newData.val() === 'ok' || newData.val() === 'stop' || newData.val() === 'sos'"
            },
            "heading": {
              ".validate": "newData.isNumber()"
            },
            "speed": {
              ".validate": "newData.isNumber()"
            },
            "accuracy": {
              ".validate": "newData.isNumber()"
            },
            "battery": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "destination": {
          ".write": "auth != null && root.child('groups').child($code).child('meta').child('createdBy').val() === auth.uid && !root.child('groups').child($code).child('meta').child('endedAt').exists()",
          ".validate": "newData.hasChildren(['lat', 'lng', 'name', 'setAt'])",
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "address": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "polyline": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          },
          "distanceM": {
            ".validate": "newData.isNumber()"
          },
          "durationS": {
            ".validate": "newData.isNumber()"
          },
          "setAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        },
        "colors": {
          ".read": "auth != null",
          "$idx": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
            ".validate": "$idx.matches(/^([0-9]|1[0-5])$/) && newData.isString()"
          }
        }
      }
    }
  }
}
